{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MediaUpload": {
    "MaxFileSizeMB": 50,
    "AllowedAudioTypes": [".mp3", ".wav", ".flac", ".aac", ".ogg"],
    "AllowedVideoTypes": [".mp4", ".avi", ".mov", ".mkv", ".webm"],
    "UploadPath": "wwwroot/uploads/media",
    "FallbackYouTubeUrl": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
  }
}
